<Application x:Class="FieldSim.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#17212B" />
        <SolidColorBrush x:Key="PanelLightBrush" Color="#22303D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#48B8A0" />
        <SolidColorBrush x:Key="TextBrush" Color="#EAF1F5" />
        <SolidColorBrush x:Key="MutedBrush" Color="#98A9B8" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelLightBrush}" />
            <Setter Property="BorderBrush" Value="#3A4A58" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
    </Application.Resources>
</Application>
